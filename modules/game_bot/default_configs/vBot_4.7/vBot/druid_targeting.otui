DruidTargetingWindow < MainWindow
  !text: tr('Configuracion: Targeting de Druid (High DPS)')
  size: 380 540
  @onEscape: self:hide()

  Label
    id: ulusTitle
    anchors.top: parent.top
    anchors.left: parent.left
    text: Spell Ulus (Donut AoE - Vacio en 8 SQMs):
    font: cipsoftFont
    color: #55ff55

  Label
    id: ulusCdTitle
    anchors.top: parent.top
    anchors.right: parent.right
    width: 80
    text: Cooldown (ms):
    font: cipsoftFont
    color: #a0a0a0

  TextEdit
    id: ulusCooldown
    anchors.top: ulusCdTitle.bottom
    anchors.right: parent.right
    width: 80
    height: 20
    margin-top: 2
    font: cipsoftFont
    tooltip: Cooldown en ms (ej: 4000)

  TextEdit
    id: ulusSpell
    anchors.top: ulusTitle.bottom
    anchors.left: parent.left
    anchors.right: ulusCooldown.left
    margin-right: 6
    margin-top: 2
    height: 20
    font: cipsoftFont

  HorizontalSeparator
    id: sepWaves
    anchors.top: ulusSpell.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  CheckBox
    id: useFrigoHur
    anchors.top: sepWaves.bottom
    anchors.left: parent.left
    margin-top: 5
    text: Usar Exevo Gran Frigo Hur (Ice Wave)
    font: cipsoftFont
    color: #66ccff

  Label
    id: frigoCdTitle
    anchors.top: sepWaves.bottom
    anchors.right: parent.right
    margin-top: 5
    width: 80
    text: Cooldown (ms):
    font: cipsoftFont
    color: #a0a0a0

  TextEdit
    id: frigoCooldown
    anchors.top: frigoCdTitle.bottom
    anchors.right: parent.right
    width: 80
    height: 20
    margin-top: 2
    font: cipsoftFont
    tooltip: Cooldown en ms (ej: 8000)

  TextEdit
    id: frigoSpell
    anchors.top: useFrigoHur.bottom
    anchors.left: parent.left
    anchors.right: frigoCooldown.left
    margin-right: 6
    margin-top: 2
    height: 20
    font: cipsoftFont

  CheckBox
    id: useTeraHur
    anchors.top: frigoSpell.bottom
    anchors.left: parent.left
    margin-top: 6
    text: Usar Exevo Tera Hur (Terra Wave)
    font: cipsoftFont
    color: #88ff88

  Label
    id: teraCdTitle
    anchors.top: frigoSpell.bottom
    anchors.right: parent.right
    margin-top: 6
    width: 80
    text: Cooldown (ms):
    font: cipsoftFont
    color: #a0a0a0

  TextEdit
    id: teraCooldown
    anchors.top: teraCdTitle.bottom
    anchors.right: parent.right
    width: 80
    height: 20
    margin-top: 2
    font: cipsoftFont
    tooltip: Cooldown en ms (ej: 4000)

  TextEdit
    id: teraSpell
    anchors.top: useTeraHur.bottom
    anchors.left: parent.left
    anchors.right: teraCooldown.left
    margin-right: 6
    margin-top: 2
    height: 20
    font: cipsoftFont

  HorizontalSeparator
    id: sep1
    anchors.top: teraSpell.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Label
    id: areaRuneLabel
    anchors.top: sep1.bottom
    anchors.left: parent.left
    margin-top: 4
    text: Runa de Area Base (Thunderlord / Thunderstorm):
    font: cipsoftFont
    color: #ffff55

  ComboBox
    id: areaRuneCombo
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 20

  Label
    id: singleLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 5
    text: Spell Single Target (Strike / Remate):
    font: cipsoftFont
    color: #ff99cc

  TextEdit
    id: singleSpell
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 20
    font: cipsoftFont

  HorizontalSeparator
    id: sep2
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Label
    id: ratioLabel
    anchors.top: sep2.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    text: Multiplicador Dano Ulus vs Runa: 2.3x
    font: cipsoftFont

  HorizontalScrollBar
    id: powerRatio
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    minimum: 10
    maximum: 50
    step: 1

  Label
    id: delayLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text: Delay entre ataques: 201 ms
    font: cipsoftFont

  HorizontalScrollBar
    id: delay
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    minimum: 50
    maximum: 1000
    step: 1

  CheckBox
    id: autoTurn
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    text: Auto-Girar hacia donde haga mayor dano
    font: cipsoftFont

  CheckBox
    id: safePvp
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text: PVP Seguro (No danar jugadores inocentes/aliados)
    font: cipsoftFont

  CheckBox
    id: prioritizeMana
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text: Priorizar Mana (>20% MP para curacion)
    font: cipsoftFont

  HorizontalSeparator
    id: sep3
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 64
    height: 20
    text: Cerrar
    font: cipsoftFont
