DruidTargetingWindow < MainWindow
  !text: tr('Configuracion: Targeting de Druid (High DPS)')
  size: 380 500
  @onEscape: self:hide()

  Label
    id: ulusTitle
    anchors.top: parent.top
    anchors.left: parent.left
    text: Spell Principal (Ulus):
    font: cipsoftFont
    color: #55ff55

  Label
    id: ulusCdTitle
    anchors.top: parent.top
    anchors.right: parent.right
    text: Cooldown (ms):
    font: cipsoftFont
    color: #a0a0a0

  TextEdit
    id: ulusSpell
    anchors.top: ulusTitle.bottom
    anchors.left: parent.left
    anchors.right: ulusCooldown.left
    margin-right: 6
    margin-top: 3
    height: 20
    font: cipsoftFont

  TextEdit
    id: ulusCooldown
    anchors.top: ulusSpell.top
    anchors.right: parent.right
    width: 80
    height: 20
    font: cipsoftFont
    tooltip: Cooldown en milisegundos (ej: 4000)

  Label
    id: ulusModeLabel
    anchors.top: ulusSpell.bottom
    anchors.left: parent.left
    margin-top: 6
    text: Forma / Modo de la Spell:
    font: cipsoftFont
    color: #ffaa00

  ComboBox
    id: ulusShapeCombo
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 20

  HorizontalSeparator
    id: sep1
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  Label
    id: areaRuneLabel
    anchors.top: sep1.bottom
    anchors.left: parent.left
    margin-top: 4
    text: Runa de Area (Thunderlord / Thunderstorm):
    font: cipsoftFont
    color: #ffff55

  ComboBox
    id: areaRuneCombo
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 20

  Label
    id: singleLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 6
    text: Spell Single Target (Strike / Remate):
    font: cipsoftFont
    color: #66ccff

  TextEdit
    id: singleSpell
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 20
    font: cipsoftFont

  HorizontalSeparator
    id: sep2
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8

  Label
    id: mathLabel
    anchors.top: sep2.bottom
    anchors.left: parent.left
    text: Formula Matematica de Decision:
    font: cipsoftFont
    color: #ff77ff

  Label
    id: ratioLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    text: Potencia Ulus vs Runa (Ratio x): 2.2x
    font: cipsoftFont

  HorizontalScrollBar
    id: powerRatio
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    minimum: 10
    maximum: 50
    step: 1

  Label
    id: delayLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    text: Delay entre ataques: 201 ms
    font: cipsoftFont

  HorizontalScrollBar
    id: delay
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    minimum: 50
    maximum: 1000
    step: 1

  CheckBox
    id: autoTurn
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    text: Auto-Acomodar (Girar al lado que mas dano haga)
    font: cipsoftFont

  CheckBox
    id: autoStep
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    text: Acomodar paso (1 SQM si aumenta >= 2 monstruos)
    font: cipsoftFont

  CheckBox
    id: safePvp
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    text: PVP Seguro (No danar jugadores inocentes)
    font: cipsoftFont

  CheckBox
    id: prioritizeMana
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5
    text: Priorizar Mana (>20% MP para seguridad)
    font: cipsoftFont

  HorizontalSeparator
    id: sep3
    anchors.bottom: closeButton.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 8

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    width: 64
    height: 20
    text: Cerrar
    font: cipsoftFont
